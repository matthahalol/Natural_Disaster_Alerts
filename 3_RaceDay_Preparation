   "source": [
    "# Data Collection and Cleaning\n",
    "# We used the “earthquake dataset.csv” file, which includes details like magnitude and location. The data was cleaned by removing rows with missing values to ensure accuracy.\n",
    "\n",
    "#Data Analysis and Visualization\n",
    "# We calculad the average and standard deviation of earthquake magnitudes. A histogram was created to visualize the distribution. Howeer, the data showed little variation in magnitude, resulting in a fairly uniform distribution.\n",
    "\n",
    "#Updated Strategy\n",
    "# Since the data didn’t show significant seismic activity variations, the strategy is to maintai a standard response across regions.\n",
    "\n",
    "# Loading the Dataset\n",
    "# In this section, we loaded the earthquake dataset and clean it by removing missing values\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Load the dataset\n",
    "data = pd.read_csv('earthquick dataset.csv', encoding='ISO-8859-1')\n",
    "\n",
    "# Clean the data\n",
    "data_cleaned = data.dropna()\n",
    "\n",
    "# Display first few rows of the cleaned data\n",
    "data_cleaned.head()\n",
    "\n",
    "# Visualizing Earthquake Magnitudes\n",
    "# We will create a histogram to analyze the distributon of earthquake magnitudes in the dataset.\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Create a histogram for earthquake magnitudes\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.hist(data_cleaned['Mag'], bins=20, edgecolor='black')\n",
    "plt.title('Histogram of Earthquake Magnitudes')\n",
    "plt.xlabel('Magnitude')\n",
    "plt.ylabel('Frequency')\n",
    "plt.show()\n",
    "\n",
    "# Scatter Plot of Latitude vs Magnitude\n",
    "# This scatter plot visualizes the relationship between latitude and earthquake magnitude\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.scatter(data_cleaned['Latitude'], data_cleaned['Mag'], alpha=0.5)\n",
    "plt.title('Scatter Plot of Latitude vs Magnitude')\n",
    "plt.xlabel('Latitude')\n",
    "plt.ylabel('Magnitude')\n",
    "plt.show()"
