import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataset with proper delimiter handling
df = pd.read_csv('Training_Strategy_Document.txt', sep='\t', engine='python', on_bad_lines='skip')

# Debugging: Check if data is loaded correctly
print("First few rows of the dataset:")
print(df.head())
print("Columns in dataset:", df.columns)

# Ensure the expected columns exist
expected_columns = {'Mag', 'Depth'}
if not expected_columns.issubset(df.columns):
    print("Error: Expected columns not found in dataset!")
    print("Available columns:", df.columns)
else:
    # Data Cleansing
    df.drop_duplicates(inplace=True)
    df.dropna(subset=['Mag', 'Depth'], inplace=True)
    df['Mag'] = pd.to_numeric(df['Mag'], errors='coerce')
    df['Depth'] = pd.to_numeric(df['Depth'], errors='coerce')
    df = df[(df['Mag'] > 0) & (df['Depth'] > 0)]

    # Data Analysis
    summary_stats = df[['Mag', 'Depth']].describe()
    print("Summary Statistics:\n", summary_stats)

    # Visualization
    if not df.empty:
        plt.figure(figsize=(12, 6))
        sns.histplot(df['Mag'], bins=20, kde=True, color='blue')
        plt.xlabel('Magnitude')
        plt.ylabel('Frequency')
        plt.title('Earthquake Magnitude Distribution')
        plt.show()

        plt.figure(figsize=(12, 6))
        sns.scatterplot(x=df['Depth'], y=df['Mag'], alpha=0.6)
        plt.xlabel('Depth (km)')
        plt.ylabel('Magnitude')
        plt.title('Depth vs Magnitude of Earthquakes')
        plt.show()
    else:
        print("Warning: Data is empty after cleansing. Check file formatting.")

    # Update Strategy Based on Analysis
    correlation = df[['Depth', 'Mag']].corr().iloc[0,1]
    if correlation < 0:
        print("Insight: Deeper earthquakes tend to have lower magnitudes.")
        print("Updated Strategy: Focus monitoring on shallower depths for higher magnitude earthquakes.")
    else:
        print("Insight: No strong inverse correlation found between depth and magnitude.")
        print("Updated Strategy: Maintain broad monitoring across all depths.")
